# StableFlow cron schedule (P1.6) — install with:
#   crontab backend/scheduling/crontab.example        (inspect first!)
# or append these lines to your existing crontab:  crontab -e
#
# All commands run from the repo root and log to data/logs/.
# Postgres must be running: make up

SHELL=/bin/bash
REPO=/home/freeman/stablecoin-flow
cd $REPO

# ── Phase 1 (P1.6) ────────────────────────────────────────────────
# supply + full-market ingest (fetch → upsert raw_* in one pass, B-D16) — daily 06:00 UTC
0 6 * * *  uv run python -m backend.ingest.defillama --coins >> data/logs/cron-defillama.log 2>&1 && cd backend/transform && uv run dbt run --profiles-dir . >> ../../data/logs/cron-dbt.log 2>&1 && uv run dbt test --profiles-dir . >> ../../data/logs/cron-dbt.log 2>&1

# ── Phase 2 (added at P2.4 / P2.9) ───────────────────────────────
# blacklist balance enrichment — daily 05:30 UTC (P2.11, needs ETH_RPC_URL)
30 5 * * *  uv run python -m indexer.bigquery.enrich_balances >> data/logs/cron-balances.log 2>&1
# transfers ingest — daily 04:00 UTC
# 0 4 * * *  ... ingest-transfers ...
# alert dispatcher — every 15 min
# */15 * * * * ... alerts/dispatcher.py ...
# daily digest — daily 07:00 UTC (P1.8)
# 0 7 * * *  uv run python -m backend.alerts.digest >> data/logs/cron-digest.log 2>&1
