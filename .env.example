# ── StableFlow environment ─────────────────────────────
# Copy to .env and fill in. NEVER commit .env.

# ── Postgres (docker-compose defaults) ──
PGHOST=localhost
PGPORT=5432
PGUSER=stableflow
PGPASSWORD=stableflow
PGDATABASE=stableflow

# ── Metabase / app ports ──
METABASE_PORT=3000
APP_PORT=8080            # 8000 is occupied on this machine

# ── DeFiLlama stablecoins API: no key required ──

# ── BigQuery (Phase 2, P2.1) ──
GOOGLE_APPLICATION_CREDENTIALS=
BQ_PROJECT=
BQ_DATASET=stableflow
BQ_MAX_BYTES_BILLED=53687091200   # 50 GB hard guard per query

# ── Ethereum archive RPC (P2.11 blacklist balance enrichment) ──
# historical eth_call (balanceOf at a past block) needs an archive node
ETH_RPC_URL=

# ── Etherscan (label verification only, P2.2) ──
ETHERSCAN_API_KEY=

# ── Address label providers (P2.2) — pick one with `--source` ──
# Arkham Intel: required for --source arkham (API-Key header)
ARKHAM_API_KEY=
# CryptoLabel: optional; anonymous tier = 1,000 req/day
CRYPTOLABEL_API_KEY=

# ── Alerts: Telegram webhook (P1.8 / P2.9) ──
TG_TOKEN=
TG_CHAT_ID=
