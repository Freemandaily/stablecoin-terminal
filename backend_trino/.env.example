TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=api-ro
TRINO_CATALOG=lake
TRINO_SOURCE_SCHEMA=stableflow
TRINO_MARTS_SCHEMA=marts
TRINO_HTTP_SCHEME=http

# Metadata-only JDBC catalog for Trino (not a data store).
PG_DB=iceberg
PG_USER=iceberg
PG_PASSWORD=iceberg

# Empty = auth disabled. Set a secret to require X-API-Key on every endpoint.
API_KEY=

CACHE_TTL_SHORT=60
CACHE_TTL_LONG=600
QUERY_TIMEOUT_S=60
