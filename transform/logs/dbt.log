  create  table "stableflow"."public"."mart_supply_chain__dbt_tmp"
  
  
    as
  
  (
    -- P1.4 (View A): per-coin per-chain supply + chain share + 30d migration delta.
-- chain-share migration is the "money moves chains" signal (View A).
with chain_rows as (

    select date, asset_id, chain, amount_usd
    from "stableflow"."public_staging"."stg_supply_daily"
    where chain <> 'ALL'

),

asset_totals as (

    select date, asset_id, sum(amount_usd) as asset_total
    from chain_rows
    group by 1, 2

),

with_share as (

    select
        c.date,
        c.asset_id,
        c.chain,
        c.amount_usd,
        c.amount_usd / nullif(a.asset_total, 0) as chain_share,
        lag(c.amount_usd / nullif(a.asset_total, 0), 30)
            over (partition by c.asset_id, c.chain order by c.date) as share_30d_ago
    from chain_rows c
    join asset_totals a using (date, asset_id)

)

select
    date,
    asset_id,
    chain,
    amount_usd,
    100 * chain_share                          as chain_share,
    100 * (chain_share - share_30d_ago)        as share_delta_30d
from with_share
  );
  
[0m16:55:48.354496 [debug] [Thread-2 (]: Opening a new connection, currently in state closed
[0m16:55:48.357216 [debug] [Thread-3 (]: Opening a new connection, currently in state closed
[0m16:55:48.358221 [debug] [Thread-4 (]: Using postgres connection "model.stableflow.mart_supply_daily"
[0m16:55:48.369792 [debug] [Thread-4 (]: On model.stableflow.mart_supply_daily: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "stableflow", "target_name": "dev", "node_id": "model.stableflow.mart_supply_daily"} */

  
    

  create  table "stableflow"."public"."mart_supply_daily__dbt_tmp"
  
  
    as
  
  (
    -- P1.4 (View A/B): per-coin daily supply + issuance deltas + market share.
-- Source: chain='ALL' total rows only (chain rows live in mart_supply_chain).
with totals as (

    select date, asset_id, amount_usd
    from "stableflow"."public_staging"."stg_supply_daily"
    where chain = 'ALL'

),

windowed as (

    select
        date,
        asset_id,
        amount_usd,
        lag(amount_usd, 1)  over w as prev_1d,
        lag(amount_usd, 7)  over w as prev_7d,
        lag(amount_usd, 30) over w as prev_30d
    from totals
    window w as (partition by asset_id order by date)

),

market as (

    select date, sum(amount_usd) as market_total
    from totals
    group by date

)

select
    w.date,
    w.asset_id,
    w.amount_usd                                                       as total_usd,
    w.amount_usd - w.prev_1d                                           as net_issuance_1d,
    w.amount_usd - w.prev_7d                                           as net_issuance_7d,
    w.amount_usd - w.prev_30d                                          as net_issuance_30d,
    100 * (w.amount_usd - w.prev_7d)  / nullif(w.prev_7d,  0)          as pct_7d,
    100 * (w.amount_usd - w.prev_30d) / nullif(w.prev_30d, 0)          as pct_30d,
    100 * w.amount_usd / nullif(m.market_total, 0)                     as share_of_market
from windowed w
join market m using (date)
  );
  
