  create  table "stableflow"."public"."mart_market_overview__dbt_tmp"
  
  
    as
  
  (
    -- P1.4 (View A): market-level daily overview — one row per date.
-- Shares for USDT/USDC resolved by symbol (unique in S1; see decisions B-D4
-- for why hardcoding ids is avoided).
with daily as (

    select date, asset_id, amount_usd
    from "stableflow"."public_staging"."stg_supply_daily"
    where chain = 'ALL'

),

market as (

    select
        date,
        sum(amount_usd)                                                as total_supply_usd,
        sum(amount_usd) - lag(sum(amount_usd), 7) over (order by date)  as supply_delta_7d
    from daily
    group by date

),

per_coin as (

    select
        date,
        asset_id,
        100 * amount_usd
            / nullif(sum(amount_usd) over (partition by date), 0) as share
    from daily

),

ranked as (

    select date, share, row_number() over (partition by date order by share desc) as rn
    from per_coin

),

top3 as (

    select date, sum(share) as top3_share
    from ranked
    where rn <= 3
    group by date

),

named_shares as (

    select
        p.date,
        max(case when a.symbol = 'USDT' then p.share end) as usdt_share,
        max(case when a.symbol = 'USDC' then p.share end) as usdc_share
    from per_coin p
    join "stableflow"."public_staging"."stg_assets" a on a.id = p.asset_id
    where a.symbol in ('USDT', 'USDC')
    group by p.date

),

chain_shares as (

    select
        date,
        100 * sum(amount_usd) filter (where chain = 'Ethereum')
            / nullif(sum(amount_usd) filter (where chain <> 'ALL'), 0) as eth_share,
        100 * sum(amount_usd) filter (where chain = 'Tron')
            / nullif(sum(amount_usd) filter (where chain <> 'ALL'), 0) as tron_share
    from "stableflow"."public_staging"."stg_supply_daily"
    where chain <> 'ALL'
    group by date

)

select
    m.date,
    m.total_supply_usd,
    m.supply_delta_7d,
    n.usdt_share,
    n.usdc_share,
    t.top3_share,
    c.eth_share,
    c.tron_share
from market m
left join named_shares n using (date)
left join top3 t using (date)
left join chain_shares c using (date)
  );
  
[0m16:43:10.533611 [debug] [Thread-3 (]: Opening a new connection, currently in state closed
[0m16:43:10.539706 [debug] [Thread-4 (]: Using postgres connection "model.stableflow.mart_supply_daily"
[0m16:43:10.540991 [debug] [Thread-4 (]: On model.stableflow.mart_supply_daily: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "stableflow", "target_name": "dev", "node_id": "model.stableflow.mart_supply_daily"} */

  
    

  create  table "stableflow"."public"."mart_supply_daily__dbt_tmp"
  
  
    as
  
  (
    -- P1.4 (View A/B): per-coin daily supply + issuance deltas + market share.
-- Source: chain='ALL' total rows only (chain rows live in mart_supply_chain).
with totals as (

    select date, asset_id, amount_usd
    from "stableflow"."public_staging"."stg_supply_daily"
    where chain = 'ALL'

),

windowed as (

    select
        date,
        asset_id,
        amount_usd,
        lag(amount_usd, 1)  over w as prev_1d,
        lag(amount_usd, 7)  over w as prev_7d,
        lag(amount_usd, 30) over w as prev_30d
    from totals
    window w as (partition by asset_id order by date)

),

market as (

    select date, sum(amount_usd) as market_total
    from totals
    group by date

)

select
    w.date,
    w.asset_id,
    w.amount_usd                                                       as total_usd,
    w.amount_usd - w.prev_1d                                           as net_issuance_1d,
    w.amount_usd - w.prev_7d                                           as net_issuance_7d,
    w.amount_usd - w.prev_30d                                          as net_issuance_30d,
    100 * (w.amount_usd - w.prev_7d)  / nullif(w.prev_7d,  0)          as pct_7d,
    100 * (w.amount_usd - w.prev_30d) / nullif(w.prev_30d, 0)          as pct_30d,
    100 * w.amount_usd / nullif(m.market_total, 0)                     as share_of_market
from windowed w
join market m using (date)
  );
  
